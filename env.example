# 이 파일을 .env 로 복사해서 쓰고, .env 는 절대 git 에 올리지 마세요.
# (.gitignore 에 .env 추가)
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/reservation_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=app_user
DB_PASSWORD=change-me
# openssl rand -base64 48 로 생성
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
CORS_ALLOWED_ORIGINS=https://app.example.com
